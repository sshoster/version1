# Copy this file to .env and fill in real values. NEVER commit .env.

# Required for the backend outside the local/test profiles (min. 32 characters).
# Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Application-level encryption key for private fields (required outside local/test).
# Generate:  openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# LLM provider: "fake" (default, deterministic, no key needed) or "openai".
# For real AI-to-AI negotiation, set:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-luna

# --- File storage ---
# "local" (default): bytes under FILE_STORAGE_PATH (./data/uploads).
# "s3": any S3-compatible service — AWS S3 (leave S3_ENDPOINT empty), Cloudflare R2,
#       or local MinIO (docker compose --profile s3 up -d minio).
# STORAGE_PROVIDER=local
# FILE_STORAGE_PATH=./data/uploads
# S3_BUCKET=debate-files
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Demo data on startup (local profile only): four users + a ready discussion.
# SEED_DEMO=true

# Rate limiting (on by default):
# RATE_LIMIT_ENABLED=true

# Optional overrides (defaults shown):
# MONGODB_URI=mongodb://localhost:27017/debate?replicaSet=rs0&directConnection=true
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# APP_BASE_URL=http://localhost:4200
# SERVER_PORT=8080

# Email provider: "smtp" (default, Gmail below) or "brevo" (HTTPS API — required on hosts
# that block SMTP, e.g. Render; verify MAIL_FROM in Brevo → Senders & Domains):
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...

# --- Email invitations (optional, via Gmail SMTP) ---
# 1. On the Google account you want to send from, enable 2-Step Verification.
# 2. Create an App Password: Google Account -> Security -> 2-Step Verification -> App passwords.
# 3. Fill in the values below and set MAIL_ENABLED=true.
# When MAIL_ENABLED is false (default), invitations still work via shareable links;
# emails are skipped and logged instead.
# MAIL_ENABLED=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# MAIL_FROM=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Windows + Docker Desktop only: Testcontainers/docker-java may need these to find the engine.
# DOCKER_HOST=npipe:////./pipe/dockerDesktopLinuxEngine
# DOCKER_API_VERSION=1.44
