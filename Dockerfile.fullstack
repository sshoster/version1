# Single-container image for public hosting (Render/Railway/Fly/AWS):
# the Spring Boot backend also serves the built Angular app (UI + API + WebSocket on one origin).
# Build context: repository root.

FROM node:24-alpine AS frontend
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend .
RUN npm run build

FROM eclipse-temurin:17-jdk AS backend
WORKDIR /workspace
COPY gradlew gradlew.bat settings.gradle.kts ./
COPY gradle gradle
COPY backend backend
RUN sh ./gradlew :backend:bootJar --no-daemon

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=backend /workspace/backend/build/libs/*.jar app.jar
COPY --from=frontend /app/dist/frontend/browser /app/public
ENV APP_STATIC_DIR=/app/public
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
